# Copy to .env (gitignored) and fill in whichever providers you have.
# You can paste the keys straight across from ../agent-sandbox/4.tool-calling/.env
# — the variable names are deliberately identical.
#
# Resolution order when LLM_PROVIDER is unset: gemini -> vertex -> radar -> arc -> github.
# Force one with:  LLM_PROVIDER=gemini|vertex|radar|arc|github

# ---- 1. Google Gemini, AI Studio key (free tier works; no VPN) ----
AGENTIC_AI_LEARNING_GEMINI_KEY=

# ---- 2. Google Gemini via Vertex AI (spends Google Cloud credits) ----
# api_key is an OAuth token, not a static key:  gcloud auth print-access-token
# Re-run that when it expires (~1 hour).
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
# VERTEX_ACCESS_TOKEN=            # leave unset to let _llm.py shell out to gcloud

# ---- 3. KCL RADAR (unlimited, no VPN) ----
RADAR_OPEN_MODEL_KEY=
RADAR_OPEN_MODEL_BASE_URL=

# ---- 4. KCL ARC-AI (needs VPN) ----
KCL_AI_MODEL_API_KEY=

# ---- 5. GitHub Models (fallback; ~10 requests/minute on free tier) ----
AGENTIC_AI_LEARNING_GH_TOKEN=

# Day 09 (later): local Jaeger via docker compose
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentconf
